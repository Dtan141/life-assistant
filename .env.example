# Copy to .env.local and fill in from Firebase Console > Project settings > Your apps.
# These are not secrets: they ship inside the client bundle by design.
# Access control lives in firestore.rules.
VITE_FIREBASE_API_KEY=
# NOT the default <project>.firebaseapp.com: this must be the domain the app
# itself is served from, so Safari does not treat the auth helper as a third
# party. worker/index.ts proxies /__/auth/ there. See its comment.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Project settings > Cloud Messaging > Web Push certificates.
# Public by design: it identifies the app to the push service, nothing more.
VITE_FIREBASE_VAPID_KEY=
