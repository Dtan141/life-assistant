rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Everything lives under users/{uid}. A signed-in user reaches their own
    // subtree and nothing else; there is no shared or public data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
