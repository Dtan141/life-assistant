{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-assistant",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // "single-page-application" returns index.html for unknown paths, so
    // client-side routes survive a refresh.
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback would swallow these before the Worker ever
    // sees them, and neither the auth proxy nor the test endpoint would run.
    "run_worker_first": ["/__/auth/*", "/__/firebase/*", "/__/reminders/*"]
  },

  // Every quarter hour. The Worker decides whose clock has reached their
  // reminder time; running more often would spend requests to gain minutes
  // nobody notices.
  "triggers": { "crons": ["*/15 * * * *"] }
}
