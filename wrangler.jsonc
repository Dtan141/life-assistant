{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-assistant",
  "compatibility_date": "2026-10-15",

  // Serve the Vite build as static assets. "single-page-application" returns
  // index.html for unknown paths, so client-side routes survive a refresh.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }

  // M4 will add a scheduled Worker here for the daily review reminder:
  //   "main": "worker/index.ts",
  //   "triggers": { "crons": ["*/15 * * * *"] }
}
