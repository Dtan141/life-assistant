{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-assistant",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // "single-page-application" returns index.html for unknown paths, so
    // client-side routes survive a refresh.
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback would swallow /__/auth/* before the
    // Worker ever sees it, and the auth proxy would never run.
    "run_worker_first": ["/__/auth/*", "/__/firebase/*"]
  }

  // M4 will add the daily reminder cron here:
  //   "triggers": { "crons": ["*/15 * * * *"] }
}
